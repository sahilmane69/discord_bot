# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Application (client) ID — same as APP_ID in the Discord Developer Portal
CLIENT_ID=your_client_id_here

# Optional: role ID allowed to skip/stop/change volume (Manage Server also works)
# If unset, everyone in the voice channel can use DJ controls.
DJ_ROLE_ID=

# Optional: only for instant dev registration in one server
# npm run register:guild
GUILD_ID=

# Optional: global (default) or guild
COMMAND_SCOPE=global
